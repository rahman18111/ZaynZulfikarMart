# ===============================================
# Konfigurasi Database
# ===============================================

# 1. Pilihan A: Menggunakan Supabase (PostgreSQL) - Sangat Direkomendasikan
# Cukup copy "URI Connection String" dari dashboard Supabase:
# Settings -> Database -> Connection String -> URI (atau Nodejs)
DATABASE_URL=postgresql://postgres:[PASSWORD-ANDA]@db.[PROJECT-REF-ANDA].supabase.co:5432/postgres

# 2. Pilihan B: Menggunakan MySQL (Lokal XAMPP / TiDB Cloud / Aiven)
# (Hanya aktif jika DATABASE_URL di atas dikosongkan)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zayn_zulfikar_store
DB_SSL=false

# Konfigurasi Server & JWT
PORT=5000
JWT_SECRET=zaynzulfikar_super_secret_jwt_key_2026_luxury_pos
NODE_ENV=production
